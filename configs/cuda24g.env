# Compatibility profile: 8 vCPU / 32GB RAM / 24GB VRAM / Ubuntu 22.04 / CUDA 13.x
# Usage:
#   export WORK=/path/to/ai-comic-drama
#   source configs/cuda24g.env
#   bash scripts/00_preflight.sh
#   bash scripts/01_bootstrap.sh
#   source venv/bin/activate
#   python scripts/02_download_models.py --profile cuda24g
#   bash scripts/03_start_comfyui.sh

export MODEL_PROFILE=cuda24g
export WORK="${WORK:-$HOME/ai-comic-drama}"

# Disk: GGUF image + 5B video + TTS + Qwen3-4B + ASR is ~64GB models.
export MIN_FREE_GB=75

# If the system Python has no torch, bootstrap installs CUDA wheels.
# CUDA 13.0 driver can also run cu128 wheels; switch if cu130 fails.
export INSTALL_TORCH=1
export TORCH_INDEX_URL="${TORCH_INDEX_URL:-https://download.pytorch.org/whl/cu130}"

# ComfyUI-GGUF is required for Q4_K_M diffusion models.
export INSTALL_GGUF=1

# 24GB VRAM: sequential loading + headroom. No --cache-none: models stay resident (~15GB),
# warm 14B I2V ~40% faster (249s->143s, peak 21.5GB no OOM @480x832/81f); re-add for S2V/higher-res.
export COMFY_VRAM_MODE=lowvram
export COMFY_RESERVE_VRAM=1.5
export COMFY_EXTRA_ARGS=""
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Recommended generation settings (set these in the exported UI workflow too).
# GGUF Q4 first runs should NOT use Lightning 4-step LoRA.
export IMAGE_STEPS=20
export IMAGE_CFG=4.0
export IMAGE_WIDTH=720
export IMAGE_HEIGHT=1280
export VIDEO_WIDTH=480
export VIDEO_HEIGHT=832
export VIDEO_FRAMES=81
export VIDEO_FPS=16

# Do not download these on 24GB/32GB unless you have a specific reason:
#   video-14b, s2v, image-bf16, llm (Qwen3-8B)