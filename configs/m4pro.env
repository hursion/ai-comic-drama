# Apple M4 Pro (12-core CPU / 16-core GPU) — MPS backend
# Unified memory: 24GB (base) or 48GB (upgraded).
# Source this BEFORE running bootstrap / start scripts.
#
# 24GB: use GGUF for both diffusion AND text encoders (fp8 not supported on MPS)
# 48GB: can use fp16/bf16 text encoders for better quality

export MODEL_PROFILE=m4pro
export WORK="${WORK:-$HOME/ai-comic-drama}"
export MIN_FREE_GB=70

# macOS: torch from PyPI includes MPS; no special index needed
export INSTALL_TORCH=1
export TORCH_INDEX_URL="${TORCH_INDEX_URL:-https://pypi.org/simple}"
export PIP_INDEX="${PIP_INDEX:-https://pypi.org/simple}"
export INSTALL_GGUF=1

# MPS memory management
export PYTORCH_MPS_HIGH_WATERMARK_RATIO=0.0
export PYTORCH_ENABLE_MPS_FALLBACK=1

# ComfyUI flags for MPS
export COMFY_VRAM_MODE=lowvram
export COMFY_RESERVE_VRAM=0
export COMFY_EXTRA_ARGS="--force-fp16 --use-split-cross-attention --cache-none"

# Generation parameters (conservative for speed)
export IMAGE_WIDTH=768
export IMAGE_HEIGHT=1344
export IMAGE_STEPS=20
export IMAGE_CFG=4.0

# Video: very slow on MPS; consider Ken Burns fallback (see doc)
export VIDEO_WIDTH=384
export VIDEO_HEIGHT=672
export VIDEO_FRAMES=49
export VIDEO_FPS=12
export VIDEO_STEPS=20
export VIDEO_CFG=3.0

# TTS on CPU (MPS audio support limited)
export TTS_DEVICE=cpu