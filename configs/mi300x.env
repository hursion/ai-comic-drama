# Original profile: ModelScope AMD MI300X 192GB / 200GB RAM / 100GB disk.
# Usage:
#   export WORK=/mnt/workspace/ai-comic-drama
#   source configs/mi300x.env
#   bash scripts/00_preflight.sh
#   bash scripts/01_bootstrap.sh
#   source venv/bin/activate
#   python scripts/02_download_models.py --profile mi300x
#   bash scripts/03_start_comfyui.sh

export MODEL_PROFILE=mi300x
export WORK="${WORK:-/mnt/workspace/ai-comic-drama}"
export MIN_FREE_GB=95

# The ModelScope image already ships ROCm torch; do not replace it.
export INSTALL_TORCH=0
export INSTALL_GGUF=0

export COMFY_VRAM_MODE=highvram
export COMFY_RESERVE_VRAM=0
export COMFY_EXTRA_ARGS=""
export PYTORCH_HIP_ALLOC_CONF=expandable_segments:True

export IMAGE_STEPS=4
export IMAGE_CFG=1.0
export IMAGE_WIDTH=1080
export IMAGE_HEIGHT=1920
export VIDEO_WIDTH=704
export VIDEO_HEIGHT=1280
export VIDEO_FRAMES=121
export VIDEO_FPS=24